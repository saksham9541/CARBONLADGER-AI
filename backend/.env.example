# =============================================================
# CarbonLedger AI — Backend Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env to version control.
# =============================================================

# ---- Application ----
APP_NAME=CarbonLedger AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- API Server ----
HOST=0.0.0.0
PORT=8000
# Comma-separated CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://carbonledger:carbonledger@localhost:5432/carbonledger
# Async variant for future use
DATABASE_URL_ASYNC=postgresql+asyncpg://carbonledger:carbonledger@localhost:5432/carbonledger

# ---- Security ----
SECRET_KEY=CHANGE_ME_to_a_random_64_char_string_before_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ---- File Storage ----
# Local for development; switch to Supabase/GCS in production
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=50

# ---- Supabase Auth & Storage ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=carbonledger-evidence
# Secret used for verifying symmetric HS256 JWTs (local Supabase or secret key)
SUPABASE_JWT_SECRET=
# Expected JWT audience (default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
# Custom JWKS URL (optional; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=

# ---- Gemini AI (Phase 2+) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Sentry (optional) ----
SENTRY_DSN=
